# ==============================================================================
# Variáveis de Ambiente da Aplicação de Lista de Compras
# ==============================================================================

# "production" exige DATABASE_URL e segredo JWT e desliga o modo demo/memória.
# No Railway isso é detectado automaticamente (RAILWAY_ENVIRONMENT).
APP_ENV=development

# Porta do Servidor Backend Axum
PORT=3000

# String de Conexão com o Banco de Dados PostgreSQL (Supabase)
# Exemplo (Session Pooler na porta 5432 ou Transaction Pooler na porta 6543):
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Aplica migrations/*.sql ao iniciar (use a porta 5432 / Session Pooler para isso)
RUN_MIGRATIONS=false

# Configurações do Projeto Supabase (obrigatórias para o login com Google)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Segredo de assinatura dos tokens do app (mínimo 32 caracteres; obrigatório em produção)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-found-in-project-settings-api

# Client ID(s) OAuth do Google aceitos em id_tokens (separe vários por vírgula)
GOOGLE_CLIENT_ID=

# Reativa a conta demo compartilhada em produção (não recomendado)
ALLOW_DEMO=false

# URL Base da API Backend (lida pelo app na COMPILAÇÃO do frontend)
API_BASE_URL=http://127.0.0.1:3000
