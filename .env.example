# ==============================================================================
# Variáveis de Ambiente da Aplicação de Lista de Compras
# ==============================================================================

# Porta do Servidor Backend Axum (Padrão: 3000 ou 8080)
PORT=3000

# String de Conexão com o Banco de Dados PostgreSQL (Supabase Free Tier)
# Exemplo (Session Pooler do Supabase na porta 5432 ou Transaction Pooler na porta 6543):
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Configurações do Projeto Supabase
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-found-in-project-settings-api

# URL Base da API Backend (Utilizada pelo App Frontend)
API_BASE_URL=http://127.0.0.1:3000
WS_BASE_URL=ws://127.0.0.1:3000/ws
